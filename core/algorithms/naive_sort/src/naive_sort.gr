// naive_sort.gr — Módulo Naive Sort con ordenamientos elementales
//
// Especificación: 05_Naive_Sort
//
// Funciones del contrato (List<Number> -> List<Number>), de menor a mayor:
//   selectionSort  — encuentra el mínimo del tramo no ordenado y lo ubica al inicio
//   bubbleSort     — compara e intercambia adyacentes, con bandera `swapped`
//   insertionSort  — inserta cada elemento en su sub-lista ordenada
//
// Caso nulo: Grain no admite `null`/`nil` ni una lista inválida, así que el
// indicador de fallo del lenguaje no es representable (igual que en F# y Gleam).
module NaiveSort

provide let rec selectionsort = (arr: List<Number>) {
    let rec pickMin = (minValue, acc, remaining) {
        match remaining {
            [] => List.append(acc, [minValue])
            | x::xs =>
                if x < minValue {
                    pickMin(x, List.append(acc, [minValue]), xs)
                } else {
                    pickMin(minValue, List.append(acc, [x]), xs)
                }
        }
    }
    match arr {
        [] => []
        | x::xs => pickMin(x, [], xs)
    }
}
provide let rec bubblesort = (arr: List<Number>) {
    let rec loop = (swapped, arr) {
        if not swapped {
            arr
        } else {
            let rec inner = (i, swapped, arr) {
                if i >= List.length(arr) - 1 {
                    loop(swapped, arr)
                } else {
                    if List.get(arr, i) > List.get(arr, i + 1) {
                        let arr = List.set(arr, i, List.get(arr, i + 1))
                        let arr = List.set(arr, i + 1, List.get(arr, i))
                        inner(i + 1, true, arr)
                    } else {
                        inner(i + 1, swapped, arr)
                    }
                }
            }
            inner(0, false, arr)
        }
    }
    loop(true, arr)
}
provide let rec insertionsort = (arr: List<Number>) {
    let rec insert = (sorted, x) {
        match sorted {
            [] => [x]
            | y::ys =>
                if x < y {
                    List.append([x], List.append([y], ys))
                } else {
                    List.append([y], insert(ys, x))
                }
        }
    }
    let rec loop = (sorted, remaining) {
        match remaining {
            [] => sorted
            | x::xs => loop(insert(sorted, x), xs)
        }
    }
    loop([], arr)
}
// Fin del módulo NaiveSort
