// data_structures_basics.gr — Celda enlazada compartida, lista enlazada, pila y cola
//
// Especificación: 06_Data_Structures_Basics
//
// Contrato del paso 4b: declara los tipos nuevos y las firmas, y deja el cuerpo
// de cada operación en su indicador natural, sin resolver ningún caso. El
// algoritmo es del paso 5 y la suite, del 4c.
//
// Indicadores:
//   - la ausencia de enlace es `None`, que solo aparece en los punteros a `Node`
//     (`Node.next`, `head`, `tail`, `top`, `front` y `rear`); ninguna operación
//     pública devuelve `Option` ni `Result`;
//   - las operaciones que extraen un número devuelven `Number` y su fallo es `-1`;
//   - las banderas devuelven `Bool` y su fallo es `false`;
//   - los contadores devuelven `Number` y parten de `0`;
//   - `linkedListDelete`, `stackPop` y `queueDequeue` devuelven una tupla
//     `(valor o éxito, estructura)`: en el fallo, el indicador y la misma
//     estructura, nunca una excepción.
//
// Grain es inmutable: cada operación devuelve un valor nuevo.
module DataStructuresBasics

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

/// Celda enlazada compartida por LinkedList, Stack y Queue.
abstract record rec Node {
  value: Number,
  next: Option<Node>,
}

/// Lista enlazada construida a mano sobre Node.
abstract record LinkedList {
  head: Option<Node>,
  tail: Option<Node>,
  count: Number,
}

/// Pila LIFO construida a mano sobre Node.
abstract record Stack {
  top: Option<Node>,
  count: Number,
}

/// Cola FIFO construida a mano sobre Node.
abstract record Queue {
  front: Option<Node>,
  rear: Option<Node>,
  count: Number,
}

// ---------------------------------------------------------------------------
// Node — celda enlazada compartida por las tres estructuras
// ---------------------------------------------------------------------------

/// Crea la celda con su valor y el enlace ausente (`init`).
provide let nodeInit = (value: Number) => {
  { value, next: None }
}

/// Valor de la celda (`get_value`).
provide let nodeValue = (node: Node) => node.value

/// Enlace de la celda; `None` cuando está ausente (`get_next`).
provide let nodeNext = (node: Node) => node.next

/// Devuelve una celda nueva enlazada con `next` (`set_next`).
provide let nodeWithNext = (node: Node, next: Node) => {
  { ...node, next: Some(next) }
}

// ---------------------------------------------------------------------------
// Helpers internos: recorren la cadena con recursión de cola
// ---------------------------------------------------------------------------

// Reengancha `values` (en orden inverso) delante de `next`. Llamada de cola.
let rec relink = (values: List<Number>, next: Option<Node>) => {
  match (values) {
    [] => next,
    [value, ...rest] => relink(rest, Some({ value, next })),
  }
}

// Última celda de una cadena. Llamada de cola.
let rec lastNode = (node: Node) => {
  match (nodeNext(node)) {
    None => node,
    Some(next) => lastNode(next),
  }
}

// Valores de la cadena hasta la cola, en orden inverso. Llamada de cola.
let rec collectToTail = (node: Option<Node>, acc: List<Number>) => {
  match (node) {
    None => acc,
    Some(current) =>
      match (nodeNext(current)) {
        None => [nodeValue(current), ...acc],
        Some(next) => collectToTail(Some(next), [nodeValue(current), ...acc]),
      },
  }
}

// Prefijo anterior a la primera aparición de `value` (en orden inverso), el
// resto de la cadena y si se encontró. Llamada de cola.
let rec takePrefix = (node: Option<Node>, value: Number, acc: List<Number>) => {
  match (node) {
    None => (false, acc, None),
    Some(current) =>
      if (nodeValue(current) == value) {
        (true, acc, nodeNext(current))
      } else {
        takePrefix(nodeNext(current), value, [nodeValue(current), ...acc])
      },
  }
}

// ---------------------------------------------------------------------------
// LinkedList
// ---------------------------------------------------------------------------

/// Lista vacía: sin cabeza, sin cola y contador a cero (`init`).
provide let linkedListInit = () => {
  { head: None, tail: None, count: 0 }
}

/// Valor de la cabeza, o `-1` si la lista está vacía (`get_head`).
provide let linkedListHead = (list: LinkedList) =>
  match (list.head) {
    Some(node) => nodeValue(node),
    None => -1,
  }

/// Inserta el valor al principio de la lista (`insert_head`).
provide let linkedListInsertHead = (list: LinkedList, value: Number) => {
  let newNode = nodeInit(value)
  let newHead = match (list.head) {
    None => newNode,
    Some(oldHead) => nodeWithNext(newNode, oldHead),
  }
  let newTail = match (list.tail) {
    None => Some(newHead),
    Some(_) => list.tail,
  }
  { head: Some(newHead), tail: newTail, count: list.count + 1 }
}

/// Inserta el valor al final de la lista (`insert_tail`).
///
/// Grain es inmutable: la celda de cola no se puede enlazar en el sitio, así que
/// se reconstruye el camino hasta ella (O(n); ver adaptaciones en el README).
provide let linkedListInsertTail = (list: LinkedList, value: Number) => {
  let newTail = nodeInit(value)
  match (list.head) {
    None => { head: Some(newTail), tail: Some(newTail), count: 1 },
    Some(_) => {
      let values = collectToTail(list.head, [])
      let newHead = relink(values, Some(newTail))
      { head: newHead, tail: Some(newTail), count: list.count + 1 }
    },
  }
}

/// Elimina la primera aparición: `(true, lista resultante)` si estaba, y
/// `(false, la misma lista)` si el valor no está (`delete`).
provide let linkedListDelete = (list: LinkedList, value: Number) => {
  match (list.head) {
    None => (false, list),
    Some(head) => {
      let (removed, prefix, rest) = takePrefix(Some(head), value, [])
      if (removed) {
        let newHead = relink(prefix, rest)
        let newTail = match (newHead) {
          None => None,
          Some(node) => Some(lastNode(node)),
        }
        (true, { head: newHead, tail: newTail, count: list.count - 1 })
      } else {
        // El valor ausente no toca la lista: se devuelve la misma instancia.
        (false, list)
      }
    },
  }
}

/// Indica si la lista no tiene nodos (`is_empty`).
provide let linkedListIsEmpty = (list: LinkedList) => list.count == 0

/// Número de nodos de la lista (`size`).
provide let linkedListSize = (list: LinkedList) => list.count

// ---------------------------------------------------------------------------
// Stack — LIFO sobre el mismo Node
// ---------------------------------------------------------------------------

/// Pila vacía: sin tope y contador a cero (`init`).
provide let stackInit = () => {
  { top: None, count: 0 }
}

/// Apila el valor sobre el tope (`push`).
provide let stackPush = (stack: Stack, value: Number) => {
  let newNode = nodeInit(value)
  let newTop = match (stack.top) {
    None => newNode,
    Some(oldTop) => nodeWithNext(newNode, oldTop),
  }
  { top: Some(newTop), count: stack.count + 1 }
}

/// Extrae el tope: `(valor, pila)`; si la pila está vacía, `(-1, la misma pila)`
/// (`pop`).
provide let stackPop = (stack: Stack) => {
  match (stack.top) {
    None => (-1, stack),
    Some(n) => (nodeValue(n), { top: nodeNext(n), count: stack.count - 1 }),
  }
}

/// Observa el tope sin extraerlo: el valor, o `-1` si la pila está vacía
/// (`peek`).
provide let stackPeek = (stack: Stack) =>
  match (stack.top) {
    None => -1,
    Some(n) => nodeValue(n),
  }

/// Indica si la pila no tiene nodos (`is_empty`).
provide let stackIsEmpty = (stack: Stack) => stack.count == 0

/// Número de nodos de la pila (`size`).
provide let stackSize = (stack: Stack) => stack.count

// ---------------------------------------------------------------------------
// Queue — FIFO sobre el mismo Node
// ---------------------------------------------------------------------------

/// Cola vacía: sin frente, sin cola y contador a cero (`init`).
provide let queueInit = () => {
  { front: None, rear: None, count: 0 }
}

/// Encola el valor por el final (`enqueue`).
///
/// Misma adaptación que `linkedListInsertTail`: encolar reconstruye el camino
/// hasta el `rear` (O(n) en vez del O(1) que promete la especificación).
provide let queueEnqueue = (queue: Queue, value: Number) => {
  let newRear = nodeInit(value)
  match (queue.front) {
    None => { front: Some(newRear), rear: Some(newRear), count: 1 },
    Some(_) => {
      let values = collectToTail(queue.front, [])
      let newFront = relink(values, Some(newRear))
      { front: newFront, rear: Some(newRear), count: queue.count + 1 }
    },
  }
}

/// Extrae el frente: `(valor, cola)`; si la cola está vacía, `(-1, la misma
/// cola)` (`dequeue`).
provide let queueDequeue = (queue: Queue) => {
  match (queue.front) {
    None => (-1, queue),
    Some(node) => {
      let newFront = nodeNext(node)
      let newRear = match (newFront) {
        None => None,
        Some(_) => queue.rear,
      }
      (nodeValue(node), { front: newFront, rear: newRear, count: queue.count - 1 })
    },
  }
}

/// Observa el frente sin extraerlo: el valor, o `-1` si la cola está vacía
/// (`peek`).
provide let queuePeek = (queue: Queue) =>
  match (queue.front) {
    None => -1,
    Some(n) => nodeValue(n),
  }

/// Indica si la cola no tiene nodos (`is_empty`).
provide let queueIsEmpty = (queue: Queue) => queue.count == 0

/// Número de nodos de la cola (`size`).
provide let queueSize = (queue: Queue) => queue.count
